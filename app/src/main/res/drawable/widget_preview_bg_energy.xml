<?xml version="1.0" encoding="utf-8"?>
<!--
  The energy widget's picker preview card (widgets spec 6.4): the edge card's black, its light in Energy's ink
  filling across from the left to the sample's level, 62%, then fading out, as the widget's level light.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0A0B" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="0" android:type="linear" android:centerX="0.62"
                android:startColor="#75F66C28" android:centerColor="#4DF66C28" android:endColor="#00F66C28" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
