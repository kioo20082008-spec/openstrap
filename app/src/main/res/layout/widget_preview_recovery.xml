<?xml version="1.0" encoding="utf-8"?>
<!--
  The recovery widget in the launcher's picker on Android 12 and later (widgets spec 6.4): the fill look as the picker's
  preview image draws it (widget_preview_recovery, from the approved mockup), scaled into the cell. Android 15 and later
  show the generated preview from the real layout instead (WidgetUpdater.publishPreviews).
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/widget_preview_recovery"
    android:scaleType="fitCenter"
    android:adjustViewBounds="true"
    android:contentDescription="@string/widget_recovery_name" />
